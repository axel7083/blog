---
import { SITE } from '@/site';

interface Props {
  title: string;
  description: string;
  /** Overrides the canonical URL, e.g. for posts first published elsewhere. */
  canonical?: string;
  /** Present for articles: enables og:type=article and BlogPosting JSON-LD */
  article?: {
    published: Date;
    modified?: Date;
    tags: string[];
    /** The series the post belongs to, for the JSON-LD `isPartOf`. */
    series?: { title: string; url: string };
  };
  /** Link-preview image, a path under /og/ (1200×630). */
  image?: string;
}

const { title, description, article, image = '/og/default.png' } = Astro.props;
const imageUrl = new URL(image, Astro.site).href;
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;

const author = { '@type': 'Person', name: SITE.author, url: SITE.authorUrl };
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      url: canonical.href,
      mainEntityOfPage: canonical.href,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      author,
      publisher: author,
      keywords: article.tags.join(', '),
      image: imageUrl,
      inLanguage: SITE.lang,
      ...(article.series && {
        isPartOf: { '@type': 'CreativeWorkSeries', name: article.series.title, url: article.series.url },
      }),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.title,
      description,
      url: Astro.site?.href,
      author,
      inLanguage: SITE.lang,
    };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('rss.xml', Astro.site)} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#14202e" />

<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{
  article && (
    <>
      <meta property="article:published_time" content={article.published.toISOString()} />
      {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
