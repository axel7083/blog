---
import { Image } from 'astro:assets';
import { type Pull, formatDate, getPull, safe } from '@/lib/github';
import CardShell from './CardShell.astro';
import Fallback from './Fallback.astro';
import Labels from './Labels.astro';
import Octicon from './Octicon.astro';

interface Props {
  /** "owner/name" */
  repo: string;
  number: number;
}

const { repo, number } = Astro.props;
const data = await safe(() => getPull(repo, number), `${repo}#${number}`);

const states: Record<Pull['state'], { icon: string; text: string; color: string }> = {
  open: { icon: 'git-pull-request', text: 'Open', color: 'var(--gh-open)' },
  draft: { icon: 'git-pull-request-draft', text: 'Draft', color: 'var(--gh-muted)' },
  merged: { icon: 'git-merge', text: 'Merged', color: 'var(--gh-done)' },
  closed: { icon: 'git-pull-request-closed', text: 'Closed', color: 'var(--gh-closed)' },
};
const state = data && states[data.state];
---

{
  data && state ? (
    <CardShell href={data.url} label={`Pull request ${data.repo}#${data.number}: ${data.title}`}>
      <div class="row">
        <span class="state" style={`color: ${state.color}`} title={state.text}>
          <Octicon name={state.icon} size={20} />
        </span>
        <div>
          <span class="gh-muted">
            {data.repo} #{data.number}
          </span>
          <h3>{data.title}</h3>
          <Labels labels={data.labels} />
          <div class="gh-meta gh-muted">
            <span>
              <Image class="gh-avatar" src={data.authorAvatar} alt="" width={20} height={20} />
              {data.author}
            </span>
            <span>
              {state.text} · <time datetime={data.mergedAt ?? data.createdAt}>{formatDate(data.mergedAt ?? data.createdAt)}</time>
            </span>
            <span title={`${data.changedFiles} files changed`}>
              <span class="add">+{data.additions}</span>
              <span class="del">−{data.deletions}</span>
            </span>
          </div>
        </div>
      </div>
    </CardShell>
  ) : (
    <Fallback href={`https://github.com/${repo}/pull/${number}`} text={`${repo}#${number}`} />
  )
}

<style>
  .row {
    display: flex;
    gap: 0.75rem;
  }
  .state {
    padding-top: 0.15rem;
  }
  h3 {
    margin: 0.15rem 0 0;
    font-size: 1.05rem;
  }
  .add {
    color: var(--gh-open);
    font-weight: 600;
  }
  .del {
    color: var(--gh-closed);
    font-weight: 600;
  }
</style>
