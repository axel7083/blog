---
import { isoDate, type Post } from '@/lib/posts';
import { type Series, seriesContext } from '@/lib/series';

interface Props {
  posts: Post[];
  /** Pass the series to label posts that belong to one. */
  series?: Series[];
}

const { posts, series = [] } = Astro.props;
---

<ol class="posts">
  {
    posts.map((post) => {
      const s = seriesContext(post, series);
      return (
      <li>
        <time class="date" datetime={post.data.pubDate.toISOString()}>
          {isoDate(post.data.pubDate)}
        </time>
        <div>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <p>{post.data.description}</p>
          {(post.data.talk || post.data.draft || s) && (
            <div class="badges stencil">
              {s && (
                <a class="series" href={`/series/${s.series.id}/`}>
                  {s.series.data.title} · Part {s.index + 1}
                </a>
              )}
              {post.data.talk && <span class="talk">Talk · {post.data.talk.event}</span>}
              {post.data.draft && <span class="draft">Draft</span>}
            </div>
          )}
        </div>
      </li>
      );
    })
  }
</ol>

<style>
  .posts {
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--fg);
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .date {
    padding-top: 0.15rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  li a {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  li p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  .talk,
  li .series {
    color: var(--accent-ink);
  }
  li .series {
    font-family: inherit;
    font-size: inherit;
    font-weight: 400;
  }
  .draft {
    padding: 0 0.4rem;
    border: 1px dashed var(--muted);
    color: var(--muted);
  }
  @media (max-width: 36rem) {
    li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
