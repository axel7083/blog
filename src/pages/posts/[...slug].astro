---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Post from '@/layouts/Post.astro';
import { getPosts } from '@/lib/posts';
import { getSeries, seriesContext } from '@/lib/series';

export const getStaticPaths = (async () => {
  const [posts, series] = await Promise.all([getPosts(), getSeries()]);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, series: seriesContext(post, series) } }));
}) satisfies GetStaticPaths;

const { post, series } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} series={series}>
  <Content />
</Post>
