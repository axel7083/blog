---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { isoDate } from '@/lib/posts';
import { getSeries } from '@/lib/series';

export const getStaticPaths = (async () => {
  const series = await getSeries();
  return series.map((s) => ({ params: { id: s.id }, props: { series: s } }));
}) satisfies GetStaticPaths;

const { series } = Astro.props;
const { Content } = await render(series);
const minutes = series.parts.reduce((sum, p) => sum + p.readingMinutes, 0);
---

<Base title={series.data.title} description={series.data.description}>
  <p class="meta stencil">
    Series · {series.parts.length} parts · {minutes} min read in total{series.data.status === 'ongoing' && ' · ongoing'}
  </p>
  <h1>{series.data.title}</h1>
  <p class="lede">{series.data.description}</p>
  <div class="prose">
    <Content />
  </div>
  <ol class="parts">
    {
      series.parts.map((part, i) => (
        <li>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <a href={`/posts/${part.id}/`}>{part.data.title}</a>
            <p>{part.data.description}</p>
            <p class="stencil small">
              <time datetime={part.data.pubDate.toISOString()}>{isoDate(part.data.pubDate)}</time>
              {` · ${part.readingMinutes} min read`}
              {part.data.draft && <span class="draft">Draft</span>}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .meta {
    margin: 0 0 1rem;
    color: var(--accent-ink);
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
  }
  .lede {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 1.1rem;
  }
  .parts {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 2px solid var(--fg);
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .num {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }
  li a {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }
  li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  li p {
    margin: 0.3rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .small {
    font-size: 0.7rem;
  }
  .draft {
    margin-left: 0.75rem;
    padding: 0 0.4rem;
    border: 1px dashed var(--muted);
  }
</style>
