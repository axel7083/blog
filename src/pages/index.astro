---
import PostList from '@/components/PostList.astro';
import Base from '@/layouts/Base.astro';
import { getPosts } from '@/lib/posts';
import { getSeries } from '@/lib/series';
import { SITE } from '@/site';

const LATEST = 5;
const [posts, series] = await Promise.all([getPosts(), getSeries()]);
---

<Base title={SITE.title} description={SITE.description}>
  <h1 class="intro">{SITE.description}</h1>
  <h2 class="stencil">Latest writing</h2>
  <PostList posts={posts.slice(0, LATEST)} series={series} />
  {posts.length > LATEST && <a class="all" href="/posts/">All writing →</a>}
</Base>

<style>
  .intro {
    margin: 0.5rem 0 3rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
  }
  h2 {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-weight: 500;
  }
  .all {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 600;
  }
</style>
